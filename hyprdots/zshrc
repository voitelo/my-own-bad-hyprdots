##### --- geminii: cd into ~/gemini only if starting in ~ ---
geminii() {
    if [[ "$PWD" = "$HOME" ]]; then
        cd "$HOME/gemini" || return
        gemini "$@"
    else
        echo "go into your home directory first"
    fi
}


