##### --- Prompt (replicating the fish prompt logic) ---
# Colors
local col_time="%K{black}%F{yellow}"
local col_user="%K{black}%F{white}"
local col_path="%K{black}%F{white}"
local col_arrow_ok="%K{black}%F{white}"
local col_arrow_fail="%K{black}%F{red}"
local col_reset="%f%k"

# ssh info
get_ssh_info() {
    if [[ -n "$SSH_CLIENT" ]]; then
        echo "(ssh from ${SSH_CLIENT%% *}) "
    fi
}

# precmd builds the prompt before each command
precmd() {
    local exit_code=$?
    local arrow="$col_arrow_ok"
    [[ $exit_code -ne 0 ]] && arrow="$col_arrow_fail"

    local time="$(date +'%H:%M')"
    local path="$(pwd)"
    local ssh_info="$(get_ssh_info)"

    PROMPT="$ssh_info$col_time$time $col_path$path $arrow❯ $col_reset "
}


##### --- Blankline enter: newline when pressing Enter on empty command ---
blankline_enter() {
    if [[ -z $BUFFER ]]; then
        print ""
        zle reset-prompt
    else
        zle accept-line
    fi
}
zle -N blankline_enter
bindkey '^M' blankline_enter     # Enter key


